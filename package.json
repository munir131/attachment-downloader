{
  "name": "attachment-downloader",
  "version": "1.2.0",
  "description": "Gmail bulk attachment downloader",
  "engines": {
    "node": "22.x",
    "bun": ">=1.0.0"
  },
  "main": "index.js",
  "type": "module",
  "directories": {
    "lib": "lib"
  },
  "dependencies": {
    "atob": "^2.1.2",
    "googleapis": "^169.0.0",
    "inquirer": "^13.1.0",
    "limiter": "^3.0.0",
    "lodash": "^4.17.23",
    "mkdirp": "^3.0.1",
    "moment": "^2.30.1",
    "moment-timezone": "^0.6.0",
    "ora": "^9.0.0",
    "winston": "^3.19.0",
    "yargs": "^18.0.0"
  },
  "devDependencies": {
    "jest": "^30.2.0"
  },
  "scripts": {
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "test:bun": "bun test",
    "start": "node index.js",
    "start:bun": "bun index.js",
    "dev": "node --watch index.js",
    "dev:bun": "bun --watch index.js",
    "build": "bun build ./index.js --outdir ./dist --target node",
    "build:binary": "bun build ./index.js --compile --outfile ./attachment-downloader",
    "build:binary:all": "bun run build:binary:windows && bun run build:binary:macos && bun run build:binary:linux",
    "build:binary:windows": "bun build ./index.js --compile --target bun-windows-x64 --outfile ./dist/attachment-downloader-windows-x64.exe",
    "build:binary:macos": "bun build ./index.js --compile --target bun-darwin-x64 --outfile ./dist/attachment-downloader-macos-x64",
    "build:binary:linux": "bun build ./index.js --compile --target bun-linux-x64 --outfile ./dist/attachment-downloader-linux-x64"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/munir131/attachment-downloader.git"
  },
  "keywords": [
    "Gmail",
    "Bulk",
    "Attachment",
    "Download",
    "Node",
    "Bun",
    "Google",
    "API",
    "oAuth",
    "Decrypt"
  ],
  "author": "Munir Khakhi",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/munir131/attachment-downloader/issues"
  },
  "homepage": "https://github.com/munir131/attachment-downloader#readme",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com/"
  }
}
